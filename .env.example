# 复制成 .env 后填写。.env 不入库。
#
# ⚠️ SUPABASE_DSN 是 **Postgres 连接串**，不是 Supabase 的 REST URL——
#    因为要用 `for update skip locked` 这类原生 SQL，走的是 psycopg 直连，
#    不是 PostgREST（见 core/repo/supabase.py 开头）。
#    用连接池端口 6543，不要用直连端口：免费版有连接数上限，
#    而采集侧会开 2~4 个进程。
SUPABASE_DSN=postgresql://postgres.<ref>:<password>@<host>:6543/postgres

# AI 分析用的模型与密钥
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# 一次推给 AI 的条数（见架构文档 4.2）
AI_BATCH_SIZE=8

# 仓库根目录。留空则自动取 core/config.py 所在仓库的根
SENTINEL_Q_ROOT=

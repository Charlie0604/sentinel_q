# 复制成 .env 后填写。.env 不入库。
#
# ⚠️ SUPABASE_DSN 是 **Postgres 连接串**，不是 Supabase 的 REST URL——
#    因为要用 `on conflict do nothing returning`、`= any(...)` 这类原生 SQL，
#    走的是 psycopg 直连，不是 PostgREST（见 src/sentinel_q/storage/supabase.py 开头）。
#    用连接池端口 6543，不要用直连端口：免费版有连接数上限，
#    而采集侧会开 2~4 个进程。
#
#    ⚠️ 这里只连业务数据和提示词。爬虫的运维状态（断点、URL 清单、限流采样）
#       是本地文件，不经过这个连接（见架构文档 3.8）。
SUPABASE_DSN=postgresql://postgres.<ref>:<password>@<host>:6543/postgres

# AI 分析用的模型与密钥
#
# ⚠️ LLM_BASE_URL 是 OpenAI 兼容接口的根地址（不带 /chat/completions），
#    客户端会往上接 /chat/completions。**没有默认值**：模型名和地址是一对，
#    猜一个地址只会让人对着 404 查半天。
#
# ⚠️ LLM_MODEL 要和 LLM_BASE_URL 指向的那家对得上。两边不匹配的话，
#    第一次真调 API 就会拿到 400 model not found。
#
#    架构文档 4.3 写的工具是 DeepSeek V4 Flash，对应到今天的 API 就是
#    `deepseek-flash`（`deepseek-v4-flash` 是**旧名**，`/models` 已经不列它了）。
#    拿不准就免费问一句：curl -s https://api.deepseek.com/models -H "Authorization: Bearer $KEY"
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# 思考强度：none / low / high / max。**空着 = 不传这个字段，用服务端默认。**
#
# ⚠️ 这不是调优项，是花钱项。以 deepseek-flash 为例，服务端的
#    `default_level` 是 **high**——不填就是最高档，每判一条都在烧推理 token，
#    而这只是个分类任务。所以默认关掉。
#
# ⚠️ 还有一层：思考模式下 `temperature` 被服务端忽略，而我们要的是
#    "同一输入问两遍得到同一个答案"（决策 47 的追溯靠它）。关掉思考才成立。
#
# ⚠️ 代价是模型不再"想一遍再答"。真发现它在事件任务那种"同一家企业、另一桩事"
#    上判错，先把这个改成 low 试试，不用动代码。
LLM_REASONING_EFFORT=none

# 一次推给 AI 的条数（见架构文档 4.2）
AI_BATCH_SIZE=8

# 仓库根目录。留空则自动向上找 pyproject.toml 定位
SENTINEL_Q_ROOT=
